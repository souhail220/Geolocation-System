# Database Configuration
DATABASE_URL=postgresql://user:password@hostname:port/dbname?sslmode=require

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Spatial / routing defaults
GEOFENCE_SRID=4326
USE_TUNISIA_GEOFENCE_FALLBACK=true
ROUTE_WAYPOINTS=3
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_SECONDS=5
SIMULATION_STATUS_LOG_INTERVAL_SECONDS=10
POLLER_INTERVAL_SECONDS=60
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_WORKERS=10

# Radio state tuning
RADIO_STOLEN_PROBABILITY=0.001
SIGNAL_DROP_PROBABILITY=0.00005
BATTERY_INITIAL_MIN=95
BATTERY_INITIAL_MAX=100
BATTERY_DRAIN_MIN=0.001
BATTERY_DRAIN_MAX=0.005
SIGNAL_BASE_DBM=-50
SIGNAL_ATTENUATION_DB_PER_KM=0.04
SIGNAL_NOISE_MIN=-1
SIGNAL_NOISE_MAX=1
SIGNAL_LOST_THRESHOLD_DBM=-105
