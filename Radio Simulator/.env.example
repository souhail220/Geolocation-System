# Database Configuration
DATABASE_URL=postgresql://user:password@hostname:port/dbname?sslmode=require

# Logging: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Spatial / routing defaults
GEOFENCE_SRID=4326
USE_TUNISIA_GEOFENCE_FALLBACK=true
ROUTE_WAYPOINTS=3
OSRM_BASE_URL=http://router.project-osrm.org
OSRM_PROFILE=driving
OSRM_TIMEOUT_SECONDS=5
SIMULATION_STATUS_LOG_INTERVAL_SECONDS=10
POLLER_INTERVAL_SECONDS=30
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_WORKERS=10

# Radio state tuning
RADIO_STOLEN_PROBABILITY=0.01
SIGNAL_DROP_PROBABILITY=0.001
BATTERY_INITIAL_MIN=80
BATTERY_INITIAL_MAX=100
BATTERY_DRAIN_MIN=0.02
BATTERY_DRAIN_MAX=0.08
